# syntax=docker/dockerfile:1
# check=error=true

# The image behind the `restore` Compose service, which the operator uses to rehearse restoring a backup on
# their laptop. See docs/backups.md. It's separate from the Dockerfile so that file's last stage stays the
# production image Kamal deploys.
#
# It's the postgres:18 image, so pg_restore is the same major version as the server that wrote the dump,
# with age and rclone from Debian's own apt repository added: the same two tools script/backup-setup.sh
# installs on a host, from Ubuntu's.
FROM postgres:18

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y age ca-certificates rclone && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# script/restore-drill.sh is bind-mounted at /script by compose.yaml, so editing it needs no rebuild.
ENTRYPOINT ["/script/restore-drill.sh"]
