<% content_for :title, "Edit CSV format · Budgie" %>

<%= render "components/page_header", title: "Edit CSV format" do %>
  <%= render "components/delete_button", path: csv_format_path(@csv_format), confirm: "Delete the #{@csv_format.name_was} CSV format?#{default_for_accounts_note(@csv_format)}" %>
<% end %>

<%= render "csv_formats/form", csv_format: @csv_format, sample: @sample, preview: @preview, cancel_path: csv_formats_path %>
