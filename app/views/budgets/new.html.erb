<% content_for :title, "Set up your budget · Budgie" %>

<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-semibold">Set up your budget</h1>
  <p class="mt-2 text-gray-600">Choose the currency for your budget. All amounts are in this currency.</p>

  <%= form_with model: @budget, url: budget_path, class: "mt-8 space-y-6" do |form| %>
    <%= render "form_errors", record: @budget %>

    <div>
      <%= form.label :currency, class: "block font-medium" %>
      <%= form.select :currency, Budget.currency_options, { prompt: "Choose a currency" },
            class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>

    <%= form.submit "Create budget", class: "w-full rounded-md bg-gray-900 px-4 py-2.5 font-medium text-white hover:bg-gray-700" %>
  <% end %>
</div>
