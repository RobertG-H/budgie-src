<% content_for :title, "Set up your budget · Budgie" %>

<div class="mx-auto max-w-md">
  <%= render "components/page_header", title: "Set up your budget",
        description: "Choose the currency for your budget. All amounts are in this currency." %>

  <%= form_with model: @budget, url: budget_path, class: "mt-8 space-y-6" do |form| %>
    <%= render "form_errors", record: @budget %>

    <%= render "components/field", form: form, attribute: :currency, control: :select do |field| %>
      <%= form.select :currency, Budget.currency_options, { prompt: "Choose a currency" }, field %>
    <% end %>

    <%= form.submit "Create budget", class: "btn btn-primary btn-block" %>
  <% end %>
</div>
