<%# locals: (link_token:, title:, description:, url:, cancel_path:, mode: "connect") %>
<%# The page that opens Plaid Link with a link token the server made as it rendered: Connect a bank, and a bank's Reconnect and Choose accounts (update mode). `mode` says what the plaid-link controller sends back when Link finishes: everything Link gave for a new connection ("connect"), only the accounts now shared ("choose"), or nothing ("reconnect"), and never a token for update mode, which has nothing to exchange. %>
<%# Plaid's script has to come from Plaid itself, so it's a plain script tag here and never pinned or vendored, and only on these pages. The page is never cached, so a link token that has expired never comes back on Back, and it isn't refreshed by morphing, which could remove Link's iframe. %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <%= javascript_include_tag "https://cdn.plaid.com/link/v2/stable/link-initialize.js", nonce: true %>
<% end %>

<div class="mx-auto max-w-md" data-controller="plaid-link" data-plaid-link-token-value="<%= link_token %>" data-plaid-link-mode-value="<%= mode %>">
  <%= render "components/page_header", title: title, description: description %>

  <%# What Plaid Link gives back goes in this form's hidden fields, which the plaid-link controller fills and sends. %>
  <%= form_with url: url, scope: :plaid_link, class: "mt-8 space-y-6", data: { plaid_link_target: "form" } do %>
    <div data-plaid-link-target="fields"></div>

    <noscript>
      <p class="text-base-content/70">Connecting a bank needs JavaScript, which is off in this browser.</p>
    </noscript>
    <div role="alert" class="alert alert-error" data-plaid-link-target="unavailable" hidden>
      <span>Plaid couldn't be loaded, so this can't be done right now. Reload the page to try again.</span>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button type="button" class="btn btn-primary" disabled data-plaid-link-target="button" data-action="plaid-link#open">Continue to Plaid</button>
      <%= link_to "Cancel", cancel_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
