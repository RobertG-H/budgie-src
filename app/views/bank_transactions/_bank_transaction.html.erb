<%# locals: (bank_transaction:, budget:, origin_params:, show_account: false, show_state: true, guess: nil) %>
<%# One bank transaction in a list, as a record row: its date, its description, which Account it's in when the list has several, and its signed amount, money out red. What happens to it depends on its state: %>
<%# - unfiled: the whole row opens the filing form, which comes back to the page the list is on (`origin_params`: its `from`, and for the Bank transactions page its `filter` and `page`) %>
<%# - filed: the records it was filed as, which are ordinary and open where they're edited, a flag when they no longer add up to it, and Un-file %>
<%# - ignored: Un-ignore %>
<%# A filed or ignored one says which Filing rule did it, when one did and not a person: the rule's text and what it sets. Preload the rule and its envelope too. %>
<%# An unfiled one with a `guess` says what it was like and what it would be filed as, in a muted line, which is only a suggestion: choosing the row opens the form, which starts on it. %>
<%# The state is said in a word, so it isn't only in what's offered. A list of nothing but unfiled ones, such as the Bank transactions page in its Unfiled state, leaves it out with `show_state: false`. Preload the links and records of every one, so a list runs the same number of queries however long it is. %>
<% state = bank_transaction.state %>
<% records = bank_transaction.filed_records %>
<% rule = bank_transaction.filed_by_rule %>
<% action_class = "btn btn-ghost btn-sm -ml-3" %>

<%= render "components/record_row", href: (new_bank_transaction_filing_path(bank_transaction, **origin_params) if state == :unfiled),
      date: bank_transaction.date, description: bank_transaction.description, amount: bank_transaction.amount, budget: budget, with_year: true,
      counterpart: (bank_transaction.account.name if show_account) do %>
  <% if show_state %>
    <span class="mt-1 flex flex-wrap items-center gap-2"><%= render "components/label_badge", text: state.to_s.capitalize %></span>
  <% end %>

  <% if guess && state == :unfiled %>
    <%= render "components/row_note" do %><%= guess.label %><% end %>
  <% end %>

  <% if state == :filed %>
    <%# Each record on a line of its own, with its amount when there's more than one to tell apart. %>
    <span class="mt-1 block space-y-1">
      <% records.each do |record| %>
        <span class="block">
          <%= link_to filed_record_label(record), filed_record_path(record), class: "link" %><%= ", #{money(record.amount, budget: budget)}" if records.size > 1 %>
        </span>
      <% end %>
    </span>

    <%= render "bank_transactions/filing_rule", rule: rule if rule %>

    <% unless bank_transaction.adds_up? %>
      <span class="mt-1 flex flex-wrap items-center gap-2">
        <span class="badge badge-warning badge-sm">Doesn't add up</span>
        <span class="text-base-content/70">Its records add up to <%= money(bank_transaction.filed_total, budget: budget) %>, not <%= money(bank_transaction.amount.abs, budget: budget) %>.</span>
      </span>
    <% end %>

    <span class="mt-1 block">
      <%= button_to "Un-file", bank_transaction_filing_path(bank_transaction), method: :delete, params: origin_params,
            form: { class: "inline", data: { turbo_confirm: "Un-file this bank transaction? This deletes the records it was filed as." } }, class: action_class %>
    </span>
  <% elsif state == :ignored %>
    <%= render "bank_transactions/filing_rule", rule: rule if rule %>
    <span class="mt-1 block">
      <%= button_to "Un-ignore", bank_transaction_ignore_path(bank_transaction), method: :delete, params: origin_params,
            form: { class: "inline" }, class: action_class %>
    </span>
  <% end %>
<% end %>
