<% content_for :title, "Edit reallocation · Budgie" %>

<div class="mx-auto max-w-md">
  <%= render "components/page_header", title: "Edit reallocation" do %>
    <%= render "components/delete_button", path: envelope_reallocation_path(@reallocation),
          confirm: "Delete the #{@reallocation.description_was} reallocation?",
          params: origin_params(@month).merge({ envelope: opened_from&.id }.compact) %>
  <% end %>

  <%= render "reallocations/form", record: @reallocation %>
</div>
