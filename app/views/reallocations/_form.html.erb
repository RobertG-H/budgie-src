<%# locals: (record:) %>
<%# The form for a Reallocation, new or saved, to an envelope or to Ready to Assign: To decides which. From can be any of the budget's envelopes in use, alphabetically, and the one a saved Reallocation is already from, even when it's archived, and so can To, with only those in use, below Ready to Assign, on a prompt to choose one until they are chosen, and the first one still to choose has the focus. Once saved, To is shown as text and can't change. %>
<%# The errors on From are on `envelope` for a Reallocation to Ready to Assign, which has one envelope, and on `from_envelope` for the other kind. %>
<% from_envelopes = envelope_options(keeping: record.envelope_ids_in_database.first(1)) %>
<% envelopes = envelope_options %>
<% to_ready_to_assign = record.is_a?(Budget::ReadyToAssignReallocation) %>
<% from_attribute = to_ready_to_assign ? :envelope : :from_envelope %>
<% to_options = [ [ "Ready to Assign", Reallocating::READY_TO_ASSIGN ] ] + envelopes %>
<% saved_path = to_ready_to_assign ? ready_to_assign_reallocation_path(record) : envelope_reallocation_path(record) if record.persisted? %>

<%= form_with model: record, scope: :reallocation, url: (saved_path || reallocations_path), class: "mt-8 space-y-6" do |form| %>
  <%= render "form_errors", record: record %>
  <%= render "origin_fields", month: @month, filter: origin_filter, page: origin_page %>
  <%# The envelope whose page this was opened from, so that saving can go back to it. %>
  <%= hidden_field_tag :envelope, opened_from.id, id: nil if origin == "envelope" && opened_from %>

  <%# The errors are on the envelope, which is what the select sets through its id. %>
  <%= render "components/field", form: form, attribute: :from_envelope_id, label: "From", control: :select,
        error: record.errors.full_messages_for(from_attribute).to_sentence.presence do |field| %>
    <%= form.select :from_envelope_id, from_envelopes, { prompt: "Choose an envelope" }, required: true, autofocus: record.from_envelope_id.nil?, **field %>
  <% end %>

  <% if record.persisted? %>
    <div class="space-y-2">
      <p class="font-medium">To</p>
      <p><%= to_ready_to_assign ? "Ready to Assign" : record.to_envelope.name %></p>
      <p class="text-sm text-base-content/70">It can't be changed. Delete this Reallocation and add another to send the money somewhere else.</p>
    </div>
  <% else %>
    <%= render "components/field", form: form, attribute: :to_envelope_id, label: "To", control: :select,
          error: record.errors.full_messages_for(:to_envelope).to_sentence.presence do |field| %>
      <%= form.select :to_envelope_id, to_options, { prompt: "Choose an envelope", selected: (to_ready_to_assign ? Reallocating::READY_TO_ASSIGN : record.to_envelope_id) },
            required: true, autofocus: record.from_envelope_id.present? && !to_ready_to_assign && record.to_envelope_id.nil?, **field %>
    <% end %>
  <% end %>

  <%= render "components/field", form: form, attribute: :description, hint: "Such as Covering the dentist" do |field| %>
    <%= form.text_field :description, required: true, autofocus: record.from_envelope_id.present? && (record.persisted? || to_ready_to_assign || record.to_envelope_id.present?), **field %>
  <% end %>

  <%= render "components/field", form: form, attribute: :date do |field| %>
    <%= form.date_field :date, required: true, **field %>
  <% end %>

  <%= render "components/field", form: form, attribute: :amount do |field| %>
    <%= form.number_field :amount, step: 0.01, required: true, **field %>
  <% end %>

  <%= render "components/field", form: form, attribute: :notes, control: :textarea do |field| %>
    <%= form.text_area :notes, rows: 3, **field %>
  <% end %>

  <%= render "components/form_actions", form: form, cancel_path: cancel_path(record) %>
<% end %>
