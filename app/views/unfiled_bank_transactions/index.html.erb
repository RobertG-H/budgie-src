<% content_for :title, "Unfiled · Budgie" %>
<% budget = Current.budget %>

<%# A row with a Guess says what it was like and what it would be filed as. A Guess only suggests, so choosing the row still opens the form, which starts on it, and "File N as guessed" opens a review of the page's Guesses before anything is filed. %>
<%= render "components/page_header", title: "Unfiled",
      description: "Bank transactions, from every account, that haven't been filed or ignored yet. Choose one to file it." do %>
  <% if @guesses.any? %>
    <%= link_to "File #{@guesses.size} as guessed", new_guessed_filing_path(page: page_param), class: "btn btn-primary" %>
  <% end %>
<% end %>

<div class="mt-8">
  <% if @bank_transactions.any? %>
    <%= render "components/record_list" do %>
      <% @bank_transactions.each do |bank_transaction| %>
        <%= render "bank_transactions/bank_transaction", bank_transaction: bank_transaction, budget: budget, from: "unfiled", show_account: true, show_state: false, guess: @guesses[bank_transaction.id] %>
      <% end %>
    <% end %>

    <div class="mt-4">
      <%= render "components/pager", page: page, more: more_pages?, path: ->(number) { unfiled_bank_transactions_path(page: (number unless number == 1)) } %>
    </div>
  <% elsif page > 1 %>
    <%= render "components/empty_state", message: "There are no more unfiled bank transactions." do %>
      <%= link_to "Back to the first page", unfiled_bank_transactions_path, class: "btn" %>
    <% end %>
  <% else %>
    <%= render "components/empty_state", message: "Every bank transaction has been filed or ignored." %>
  <% end %>
</div>
