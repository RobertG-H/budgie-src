<% content_for :title, "#{@account.name} · Budgie" %>
<% budget = Current.budget %>

<%= link_to "Back to accounts", accounts_path, class: "link" %>

<div class="mt-4">
  <%= render "components/page_header", title: @account.name do %>
    <%= link_to "Import", new_account_import_path(@account), class: "btn btn-primary" %>
    <%= link_to "Edit", edit_account_path(@account), class: "btn" %>
  <% end %>
</div>

<%# Which CSV format its bank's files use, when it has one. %>
<% if @account.default_csv_format %>
  <p class="mt-2 text-base-content/70">Default CSV format: <%= @account.default_csv_format.name %></p>
<% end %>

<%# The Import that ran last, which is the one whose summary can still be looked at here. %>
<% if @latest_import %>
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
    <p class="text-base-content/70">
      Latest Import: <%= link_to @latest_import.file_name, import_path(@latest_import), class: "link" %>,
      <%= spelled_date(@latest_import.created_at) %>.
    </p>
    <%# The latest is the only one that can be undone, and only for 24 hours. %>
    <% if @latest_import.undo_window_open? %>
      <%= render "components/delete_button", path: import_path(@latest_import), label: "Undo",
            confirm: undo_confirmation(@latest_import, @latest_import.added_count) %>
    <% end %>
  </div>
<% end %>

<div class="mt-8">
  <% if @bank_transactions.any? %>
    <%= render "components/record_list" do %>
      <% @bank_transactions.each do |bank_transaction| %>
        <%= render "bank_transactions/bank_transaction", bank_transaction: bank_transaction, budget: budget, origin_params: { from: "account" } %>
      <% end %>
    <% end %>

    <div class="mt-4">
      <%= render "components/pager", page: page, more: more_pages?, path: ->(number) { account_path(@account, page: (number unless number == 1)) } %>
    </div>
  <% elsif page > 1 %>
    <%= render "components/empty_state", message: "There are no more bank transactions." do %>
      <%= link_to "Back to the first page", account_path(@account), class: "btn" %>
    <% end %>
  <% else %>
    <%= render "components/empty_state", message: "No bank transactions yet." do %>
      <%= link_to "Import", new_account_import_path(@account), class: "btn btn-primary" %>
    <% end %>
  <% end %>
</div>
