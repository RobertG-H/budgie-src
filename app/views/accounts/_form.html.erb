<%# locals: (account:, cancel_path:) %>
<%= form_with model: account, class: "mt-8 space-y-6" do |form| %>
  <%= render "form_errors", record: account %>

  <%= render "components/field", form: form, attribute: :name, hint: "Such as Chequing, or the name of a card." do |field| %>
    <%= form.text_field :name, required: true, autofocus: true, **field %>
  <% end %>

  <%# Which CSV format its bank's files use, which a file from the header is recognised by and the Account's Import form starts on. There's nothing to choose when the budget has none. Another budget's is refused by the model, on this field. %>
  <% csv_formats = Current.budget.csv_formats.alphabetical.pluck(:name, :id) %>
  <%# A synced Account has no files, so no format to read them with. %>
  <% if csv_formats.any? && !account.synced? %>
    <%= render "components/field", form: form, attribute: :default_csv_format_id, control: :select, label: "Default CSV format",
          hint: "Used to recognise which Account a file is for when you Import from the header.",
          error: account.errors.full_messages_for(:default_csv_format).to_sentence.presence do |field| %>
      <%= form.select :default_csv_format_id, csv_formats, { include_blank: "None" }, **field %>
    <% end %>
  <% end %>

  <%# Whether the budget's Filing rules file or ignore this Account's bank transactions as they come in. Off, each waits for a person, and a rule pinned to the Account does nothing: for an Account whose bank transactions are all to be looked at, such as a Splitwise one. It changes nothing that's already filed, and turning it on files nothing that's already there. %>
  <%= render "components/field", form: form, attribute: :files_with_rules, control: :checkbox, label: "File its bank transactions with Filing rules",
        hint: "Off: every bank transaction waits for you to file it or ignore it." do |field| %>
    <%= form.check_box :files_with_rules, **field %>
  <% end %>

  <%= render "components/form_actions", form: form, cancel_path: cancel_path %>
<% end %>
