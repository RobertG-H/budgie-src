<%# locals: (envelope:, cancel_path:) %>
<%= form_with model: envelope, class: "mt-8 space-y-6" do |form| %>
  <%= render "form_errors", record: envelope %>
  <%= render "origin_fields", month: @month %>

  <%= render "components/field", form: form, attribute: :name do |field| %>
    <%= form.text_field :name, required: true, autofocus: true, **field %>
  <% end %>

  <%= render "components/field", form: form, attribute: :starting_balance,
        hint: "The amount already in this envelope. Leave it blank if it's empty." do |field| %>
    <%= form.number_field :starting_balance, step: 0.01, **field %>
  <% end %>

  <%= render "components/form_actions", form: form, cancel_path: cancel_path %>
<% end %>
