<%= form_with model: envelope, class: "mt-8 space-y-6" do |form| %>
  <%= render "form_errors", record: envelope %>

  <div>
    <%= form.label :name, class: "block font-medium" %>
    <%= form.text_field :name, required: true, autofocus: true,
          class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :starting_balance, class: "block font-medium" %>
    <p class="text-sm text-gray-600">The amount already in this envelope. Leave it blank if it's empty.</p>
    <%= form.number_field :starting_balance, step: 0.01,
          class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit class: "rounded-md bg-gray-900 px-4 py-2.5 font-medium text-white hover:bg-gray-700" %>
    <%= link_to "Cancel", envelopes_path, class: "text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
