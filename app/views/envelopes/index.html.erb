<% content_for :title, "Envelopes · Budgie" %>

<%= render "components/page_header", title: "Envelopes" do %>
  <%= link_to "New envelope", new_envelope_path, class: "btn btn-primary" %>
<% end %>

<div class="mt-8">
  <% if @envelopes.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Envelope</th>
            <th scope="col" class="text-right">Starting balance</th>
            <th scope="col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @envelopes.each do |envelope| %>
            <tr id="<%= dom_id(envelope) %>">
              <td><%= envelope.name %></td>
              <td class="text-right tabular-nums"><%= render "components/money", amount: envelope.starting_balance, budget: envelope.budget %></td>
              <td>
                <div class="flex justify-end gap-2">
                  <%= link_to "Edit", edit_envelope_path(envelope), class: "btn btn-ghost btn-sm" %>
                  <%= button_to "Delete", envelope_path(envelope), method: :delete,
                        form: { data: { turbo_confirm: "Delete the #{envelope.name} envelope?" } },
                        class: "btn btn-ghost btn-sm text-error" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "components/empty_state", message: "You don't have any envelopes yet." %>
  <% end %>
</div>
