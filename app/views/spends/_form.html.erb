<%# locals: (spend:, cancel_path:) %>
<%# The envelope can be any of the budget's, alphabetically. Without one chosen the select starts on a prompt, so the form can't be sent by accident with the first envelope, and has the focus. With one chosen, as from an envelope's page, the description does. %>
<% envelopes = Current.budget.envelopes.alphabetical.pluck(:name, :id) %>

<%= form_with model: spend, class: "mt-8 space-y-6" do |form| %>
  <%= render "form_errors", record: spend %>
  <%= render "origin_fields", month: @month %>

  <%# The error is on the envelope, which is what the select sets through its id. %>
  <%= render "components/field", form: form, attribute: :envelope_id, label: "Envelope", control: :select,
        error: spend.errors.full_messages_for(:envelope).to_sentence.presence do |field| %>
    <%= form.select :envelope_id, envelopes, { prompt: "Choose an envelope" }, required: true, autofocus: spend.envelope.nil?, **field %>
  <% end %>

  <%= render "components/field", form: form, attribute: :description, hint: "Such as Loblaws" do |field| %>
    <%= form.text_field :description, required: true, autofocus: spend.envelope.present?, **field %>
  <% end %>

  <%= render "components/field", form: form, attribute: :date do |field| %>
    <%= form.date_field :date, required: true, **field %>
  <% end %>

  <%= render "components/field", form: form, attribute: :amount do |field| %>
    <%= form.number_field :amount, step: 0.01, required: true, **field %>
  <% end %>

  <%= render "components/field", form: form, attribute: :notes, control: :textarea do |field| %>
    <%= form.text_area :notes, rows: 3, **field %>
  <% end %>

  <div class="flex items-center gap-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", cancel_path, class: "btn btn-ghost" %>
  </div>
<% end %>
