<% content_for :title, "Edit spend · Budgie" %>

<div class="mx-auto max-w-md">
  <%= render "components/page_header", title: "Edit spend" do %>
    <%= render "components/delete_button", path: spend_path(@spend),
          confirm: "Delete the #{@spend.description_was} spend?",
          params: { from: origin, month: @month.to_param }.compact %>
  <% end %>

  <%= render "bank_transaction_note", record: @spend %>

  <%= render "envelope_record_form", record: @spend, hint: "Such as Loblaws",
        cancel_path: return_path(@month, envelope: origin_envelope) %>
</div>
