<% content_for :title, "File bank transaction · Budgie" %>
<% bank_transaction = @entry.bank_transaction %>

<div class="mx-auto max-w-md">
  <%= render "components/page_header", title: "File bank transaction",
        description: "Turn it into the records it was, which have to add up to its amount, or ignore it." %>

  <%# The bank transaction as the bank gave it, which is what's being filed. %>
  <%= render "components/panel", class: "mt-6" do %>
    <p class="text-base-content/70"><%= bank_transaction.account.name %>, <%= spelled_date(bank_transaction.date) %></p>
    <p class="font-semibold"><%= bank_transaction.description %></p>
    <p class="mt-1 tabular-nums">
      <%= render "components/money", amount: bank_transaction.amount, budget: Current.budget %>
      <%= render "components/label_badge", text: money_direction(bank_transaction.amount) %>
    </p>
  <% end %>

  <%= render "bank_transaction_filings/form", entry: @entry, offer: @offer, cancel_path: origin_path %>
</div>
