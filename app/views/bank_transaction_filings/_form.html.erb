<%# locals: (entry:, offer:, cancel_path:, guess: nil) %>
<%# The records a bank transaction is filed as, in one form, and then File, which files them all or none. A bank transaction can be split into several records, such as $60 from Groceries and $40 from Household, which have to add up to its amount: the filing-split Stimulus controller adds a record from the template and removes one, and says what they add up to as it goes. Ignore is another action, sent the same form, and doesn't read what's in it. %>
<%# "Always file like this" is a Filing rule made from what's done, whether it's filing or ignoring, and never from a split: the filing-split controller turns it off while there's more than one record. %>
<%# A Guess is where the form starts when no Filing rule fits and the Budget has filed something like it: the kind and the envelope are already chosen, and the line says why. It's only where it starts, so it's left off a form that's coming back as it was entered. %>
<%# Records are numbered by their place in the form, and the form sends them as a hash from each number, which the controller reads in order. A record added in the page is numbered by the time, so it's after all before it. %>
<%# For one record the form is the choice and little else: its kind and envelope, "Always file like this" with its text tucked under "Edit rule", and "Edit details" holding the rest, closed unless something in it needs attention. The rule is the first record's to hold, since it's between its envelope and its details. %>
<% bank_transaction = entry.bank_transaction %>
<% budget = Current.budget %>

<%= form_with scope: :filing, url: bank_transaction_filing_path(bank_transaction), method: :post, class: "mt-8 space-y-6" do |form| %>
  <%= render "form_errors", messages: entry.full_messages + offer.errors.full_messages %>
  <%= render "origin_fields", filter: origin_filter, page: origin_page %>

  <% if guess %>
    <p class="text-base-content/70"><%= guess.label %></p>
  <% end %>

  <div class="space-y-6" data-controller="filing-split" data-action="input->filing-split#update"
    data-filing-split-amount-value="<%= format("%.2f", bank_transaction.amount.abs) %>" data-filing-split-unit-value="<%= budget.currency_unit %>"
    data-filing-split-max-value="<%= Budget::Filing::MAX_RECORDS %>">
    <div class="space-y-8" data-filing-split-target="records">
      <% entry.drafts.each_with_index do |draft, index| %>
        <%= fields_for "filing[records][#{index}]", draft do |record_form| %>
          <%= render "bank_transaction_filings/record", form: record_form, draft: draft, bank_transaction: bank_transaction, details_open: filing_details_open?(entry, draft),
                number: index + 1, removable: entry.drafts.size > 1, autofocus: index.zero?, offer: (offer if index.zero?) %>
        <% end %>
      <% end %>
    </div>

    <%# What a record added in the page starts as: the bank transaction's own date and description, and no amount, which the controller sets to what's left. It's inert, so none of it is sent. %>
    <template data-filing-split-target="template">
      <%= fields_for "filing[records][NEW_RECORD]", Budget::Filing::Draft.for(bank_transaction, amount: nil) do |record_form| %>
        <%= render "bank_transaction_filings/record", form: record_form, draft: Budget::Filing::Draft.for(bank_transaction, amount: nil),
              bank_transaction: bank_transaction, details_open: true, number: nil, removable: true, autofocus: false %>
      <% end %>
    </template>

    <button type="button" class="btn btn-ghost btn-sm" data-action="filing-split#addRecord" data-filing-split-target="add">Add another record</button>

    <p class="<%= entry.remaining.negative? ? "text-error" : "text-base-content/70" %>" data-filing-split-target="total" aria-live="polite"><%= filing_totals(entry, budget) %></p>
  </div>

  <%= render "components/form_actions", form: form, cancel_path: cancel_path, submit: "File", autofocus: !filing_envelope_to_choose?(entry.drafts.first) do %>
    <%# Ignoring needs none of the records, so it's a button of its own that sends the form to its own address, which only reads where it was opened from. The method is stated again because the form is a post. %>
    <button type="submit" name="_method" value="post" formaction="<%= bank_transaction_ignore_path(bank_transaction) %>" formnovalidate class="btn">Ignore</button>
  <% end %>
<% end %>
