<% content_for :title, "Sign in · Budgie" %>

<div class="mx-auto max-w-sm text-center">
  <h1 class="text-2xl font-semibold">Sign in to Budgie</h1>

  <div class="mt-8 space-y-3">
    <% Rails.configuration.x.auth_providers.each do |provider, name| %>
      <%# Turbo can't follow the redirect to the provider, so this is a full page submission. %>
      <%= button_to "Sign in with #{name}", "/auth/#{provider}",
            form: { data: { turbo: false } },
            class: "w-full rounded-md bg-gray-900 px-4 py-2.5 font-medium text-white hover:bg-gray-700" %>
    <% end %>
  </div>
</div>
