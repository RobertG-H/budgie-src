<%# locals: (form:, cancel_path:) %>
<%# What ends a form: its submit button, the main action, and a Cancel link back to the page it was opened from. %>
<div class="flex items-center gap-4">
  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", cancel_path, class: "btn btn-ghost" %>
</div>
