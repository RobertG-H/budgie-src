<%# locals: (title:, description: nil, badge: nil) %>
<%# A page's h1, with an optional `badge` beside it, such as Archived, an optional line under it and, from the block, its actions on the right. The actions wrap, so however many there are, they still fit a phone. %>
<% actions = yield %>
<div class="flex flex-wrap items-start justify-between gap-4">
  <div class="space-y-2">
    <h1 class="text-2xl font-semibold"><%= title %><% if badge %> <span class="align-middle"><%= badge %></span><% end %></h1>
    <% if description %>
      <p class="text-base-content/70"><%= description %></p>
    <% end %>
  </div>
  <% if actions.present? %>
    <div class="flex flex-wrap items-center gap-2"><%= actions %></div>
  <% end %>
</div>
