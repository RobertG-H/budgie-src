<%# locals: (title:, value:, description: nil) %>
<%# One headline number, such as an envelope's Available. daisyUI mutes stat text to 60%, which is under AA here, so it's set back to 70%. %>
<%# daisyUI won't let the number or what's under it wrap, which a long description needs on a phone and a badge beside the number (Overspent) needs in a narrow card, so they can. Cards in a row stretch to the tallest, so what's in each is packed to the top, which keeps their numbers level. %>
<div class="stats w-full border border-base-300">
  <div class="stat content-start">
    <div class="stat-title text-base-content/70"><%= title %></div>
    <div class="stat-value whitespace-normal"><%= value %></div>
    <% if description %>
      <div class="stat-desc whitespace-normal text-base-content/70"><%= description %></div>
    <% end %>
  </div>
</div>
