<%# locals: (offer:) %>
<%# What making the rule would do, which depends on its text, so the filing form asks for this again as the text is edited (the sweep-preview controller sets the frame's address): it says when a Filing rule with that text exists, which is updated in place and not made again, and how many other unfiled bank transactions it would file or ignore, with a box to do that, ticked to start with. A text that isn't one a rule can have has no count, and says why. %>
<% existing = offer.existing_rule %>
<turbo-frame id="filing-rule-preview" class="block space-y-4" aria-live="polite" data-sweep-preview-target="frame">
  <% if existing %>
    <p class="font-medium">Updates the Filing rule for '<%= existing.text %>', which <%= existing.effect %> now.</p>
  <% end %>
  <% if offer.valid_text? %>
    <%= render "filing_rules/sweep_option", scope: "filing[rule]", sweep: offer.sweep_preview, checked: offer.sweep, others: true %>
  <% else %>
    <p class="text-base-content/70">The text has to be at least 3 characters, and part of this bank transaction's description.</p>
  <% end %>
</turbo-frame>
