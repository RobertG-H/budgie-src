<%# locals: (budget:) %>
<section id="record-rows" aria-labelledby="record-rows-heading" class="space-y-4 border-t border-base-300 pt-6">
  <h2 id="record-rows-heading" class="text-xl font-semibold">Record rows</h2>
  <p class="text-base-content/70">One record in a list, such as a Deposit: its date, its description with any notes as a muted second line, and its amount. A Reallocation also says where the money went or came from, such as "To Ready to Assign" or "From Dining out", and is signed from the page's side. The whole row links to where the record is edited.</p>

  <%= render "components/record_list" do %>
    <%= render "components/record_row", href: "#", date: Date.new(2026, 9, 30), description: "Paycheck",
          notes: "Biweekly, from Acme", amount: 3000, budget: budget %>
    <%= render "components/record_row", href: "#", date: Date.new(2026, 9, 18), description: "Gift",
          amount: 25.5, budget: budget %>
    <%= render "components/record_row", href: "#", date: Date.new(2026, 9, 12), description: "Covering the dentist",
          counterpart: "To Groceries", notes: "From what's left of Dining out", amount: -20, budget: budget %>
    <%= render "components/record_row", href: "#", date: Date.new(2026, 9, 11), description: "Covering the dentist",
          counterpart: "From Dining out", amount: 20, budget: budget %>
    <%= render "components/record_row", href: "#", date: Date.new(2026, 9, 5),
          description: "Reimbursed travel, with a description long enough to wrap onto a second line on a phone",
          notes: "Flights and two nights\nPaid back by the end of the month", amount: 1234.5, budget: budget %>
  <% end %>

  <h3 class="font-semibold">Read only</h3>
  <p class="text-base-content/70">A record that can't be opened, such as a bank transaction, is a row that isn't a link. A list that goes back past a year spells out the year.</p>

  <%= render "components/record_list" do %>
    <%= render "components/record_row", href: nil, date: Date.new(2026, 9, 12), description: "Loblaws", amount: -82.45, budget: budget, with_year: true %>
    <%= render "components/record_row", href: nil, date: Date.new(2025, 9, 12), description: "Paycheck", counterpart: "Money in",
          amount: 2800, budget: budget, with_year: true %>
  <% end %>
</section>
