<%# locals: (budget:) %>
<section id="cards" aria-labelledby="cards-heading" class="space-y-4 border-t border-base-300 pt-6">
  <h2 id="cards-heading" class="text-xl font-semibold">Cards</h2>

  <h3 class="font-semibold">Card</h3>
  <div class="card border border-base-300 bg-base-100">
    <div class="card-body">
      <h4 class="card-title">Card title</h4>
      <p class="text-base-content/70">A card groups related content. Its actions sit at the bottom.</p>
      <div class="card-actions justify-end">
        <button type="button" class="btn btn-primary">Action</button>
      </div>
    </div>
  </div>

  <h3 class="font-semibold">Stat card</h3>
  <%= render "components/stat_card", title: "Ready to Assign", value: money(1250, budget: budget), description: "Across 3 envelopes" %>

  <h3 class="font-semibold">Stat card that links</h3>
  <p class="text-base-content/70">Given an href, the whole card links to the records behind its number.</p>
  <%= render "components/stat_card", title: "Ready to Assign", value: money(1250, budget: budget),
        description: safe_join([ "Carried over", render("components/money", amount: -30, budget: budget), "·",
                                 "Deposited", render("components/money", amount: 1280, budget: budget) ], " "),
        href: "#" %>
</section>
