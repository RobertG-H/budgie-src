<%# locals: () %>
<section id="link-rows" aria-labelledby="link-rows-heading" class="space-y-4 border-t border-base-300 pt-6">
  <h2 id="link-rows-heading" class="text-xl font-semibold">Link rows</h2>
  <p class="text-base-content/70">One thing in a list that's opened by choosing it, such as a CSV format or an Account: its name, with a muted line under it that says more when there is one, and a short word beside the name when it needs one. The whole row links to where it's opened, so a row that holds buttons is a table row instead (see Tables).</p>

  <%= render "components/record_list" do %>
    <%= render "components/link_row", href: "#", name: "CIBC chequing",
          detail: "Date in column 1 as MM/DD/YYYY. Description in column 2. Amount in column 3, with money out as a negative amount." %>
    <%= render "components/link_row", href: "#", name: "Tangerine",
          detail: "Date in column 1 as YYYY-MM-DD. Description in columns 2 and 3. Money in is in column 5, and money out is in column 4." %>
    <%= render "components/link_row", href: "#", name: "Savings" %>
    <%= render "components/link_row", href: "#", name: "Joint chequing", badge: "Inactive", detail: "Not used for new Imports." %>
  <% end %>
</section>
