<%# locals: () %>
<section id="alerts" aria-labelledby="alerts-heading" class="space-y-4 border-t border-base-300 pt-6">
  <h2 id="alerts-heading" class="text-xl font-semibold">Alerts and flash</h2>
  <p class="text-base-content/70">The layout shows each flash message with the components/flash partial: notice is success, alert is error.</p>

  <div class="space-y-2">
    <%= render "components/flash", type: :notice, message: "Envelope created." %>
    <%= render "components/flash", type: :alert, message: "We couldn't sign you in." %>
    <%= render "components/flash", type: :info, message: "An info message." %>
    <%= render "components/flash", type: :warning, message: "A warning message." %>
  </div>

  <h3 class="font-semibold">Badges</h3>
  <div class="flex flex-wrap items-center gap-2">
    <span class="badge">Default</span>
    <span class="badge badge-primary">Primary</span>
    <span class="badge badge-success">Success</span>
    <span class="badge badge-warning">Warning</span>
    <span class="badge badge-error">Overspent</span>
    <%= render "components/archived_badge" %>
  </div>
</section>
