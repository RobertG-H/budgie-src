<% content_for :title, "Styleguide · Budgie" %>

<%= render "components/page_header", title: "Styleguide",
      description: "The Budgie theme and its base components, drawn from sample data. Local development only." %>

<div class="mt-8 space-y-8">
  <%= render "dev/styleguide/colours" %>
  <%= render "dev/styleguide/buttons" %>
  <%= render "dev/styleguide/fields" %>
  <%= render "dev/styleguide/tables", budget: @budget %>
  <%= render "dev/styleguide/available_bars", budget: @budget %>
  <%= render "dev/styleguide/cards", budget: @budget %>
  <%= render "dev/styleguide/terms", budget: @budget %>
  <%= render "dev/styleguide/month_links", budget: @budget %>
  <%= render "dev/styleguide/date_range_filter" %>
  <%= render "dev/styleguide/record_rows", budget: @budget %>
  <%= render "dev/styleguide/link_rows" %>
  <%= render "dev/styleguide/panels" %>
  <%= render "dev/styleguide/sample_grid" %>
  <%= render "dev/styleguide/pager" %>
  <%= render "dev/styleguide/alerts" %>
  <%= render "dev/styleguide/empty_states" %>
  <%= render "dev/styleguide/modals" %>
</div>
