<% content_for :title, "Edit deposit · Budgie" %>

<div class="mx-auto max-w-md">
  <%= render "components/page_header", title: "Edit deposit" do %>
    <%= render "components/delete_button", path: deposit_path(@deposit),
          confirm: "Delete the #{@deposit.description_was} deposit?",
          params: { from: origin, month: @month.to_param }.compact %>
  <% end %>

  <%= render "bank_transaction_note", record: @deposit %>

  <%= render "form", deposit: @deposit, cancel_path: return_path(@month) %>
</div>
