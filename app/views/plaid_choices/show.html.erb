<%# Connecting a bank, or Choose accounts on one that's already connected (`@chooser`), which lists only the selected accounts that aren't Accounts yet, says which Accounts stop being shared, and saves. %>
<% bank = @link.institution_name %>
<% title = @chooser ? "Choose accounts on #{bank}" : "Connect #{bank}" %>
<% content_for :title, "#{title} · Budgie" %>
<%# Never cached: once it's submitted or cancelled, or its 30 minutes are up, there's nothing to come back to. %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="mx-auto max-w-xl">
  <%= render "components/page_header", title: title %>
  <div class="mt-2 space-y-2">
    <% if @chooser %>
      <p class="text-base-content/70">
        <%= bank %> now shares <%= pluralize(@choices.size, "account") %> that <%= @choices.one? ? "isn't an Account" : "aren't Accounts" %> yet. Choose what each one becomes.
        Nothing is saved until you press Save, which has to be within 30 minutes.
      </p>
      <% deselected = @chooser.deselected_accounts %>
      <% if deselected.any? %>
        <p class="text-base-content/70">
          <%= deselected.map(&:name).to_sentence %> <%= deselected.one? ? "isn't" : "aren't" %> shared any more, so once you save, nothing new comes in.
          <%= deselected.one? ? "Its" : "Their" %> bank transactions stay as they are.
        </p>
      <% end %>
    <% else %>
      <p class="text-base-content/70">
        You shared <%= pluralize(@link.accounts.size, "account") %> from <%= bank %>. Choose what each one becomes.
        Nothing is connected until you press Connect <%= bank %>, which has to be within 30 minutes.
      </p>
      <%= render "plaid_choices/currency_hint", currency: Current.budget.currency %>
    <% end %>
  </div>

  <%= form_with url: plaid_choice_path, scope: :plaid_choice, class: "mt-8 space-y-8" do |form| %>
    <%= render "form_errors", messages: [ @error, *@choices.flat_map { |choice| choice.errors.full_messages.map { "#{choice.shared_account.name}: #{it}" } } ].compact %>

    <%= render "components/record_list" do %>
      <% @choices.each do |choice| %>
        <%= render "plaid_choices/choice", form: form, choice: choice, index: choice.index %>
      <% end %>
    <% end %>

    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit (@chooser ? "Save" : "Connect #{bank}"), class: "btn btn-primary" %>
      <%# Cancel forgets what Plaid Link gave back, so it's a request of its own and not a link. %>
      <%= button_tag "Cancel", type: "submit", formaction: plaid_choice_path, name: "_method", value: "delete", formnovalidate: true, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
