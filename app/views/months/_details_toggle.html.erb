<%# locals: () %>
<%# The one switch for the table's Carried over, Refunded and Reallocated, which are hidden until it's on. Whether it's on is data-details on <html>, which the month-details controller flips and keeps aria-pressed in step with; every other piece of markup reads that attribute. Both hint texts and both labels are always there, stacked in one grid cell with the one that doesn't apply `invisible`, so the row is as tall and as wide as the longer of each in either state and the table never moves when this changes. %>
<div class="mb-2 flex items-start justify-between gap-4">
  <div class="grid text-sm text-base-content/70">
    <p class="col-start-1 row-start-1 in-data-[details=on]:invisible">Carried over, Refunded and Reallocated are hidden, so the figures below don't add up on their own.</p>
    <p class="invisible col-start-1 row-start-1 in-data-[details=on]:visible">Carried over, Refunded and Reallocated are shown, so the figures below add up to Available.</p>
  </div>
  <button type="button" class="btn btn-sm shrink-0 aria-pressed:btn-active" aria-pressed="false" data-month-details-target="button" data-action="month-details#toggle">
    <span class="grid">
      <span class="col-start-1 row-start-1 in-data-[details=on]:invisible">Show details</span>
      <span class="invisible col-start-1 row-start-1 in-data-[details=on]:visible">Hide details</span>
    </span>
  </button>
</div>
