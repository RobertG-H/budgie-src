<%# locals: (month:, budget:, origin_page:) %>
<%# PROTOTYPE C, "Bar behind the figure": a tinted fill sits behind Available's figure like a spreadsheet data bar, with an icon before the
    figure. The toggle is a two-button segmented control, Summary or Details, with its warning written for the state being looked at.
    On a phone the breakdown stacks, right-aligned, under the Available figure. %>
<div data-controller="month-details">
  <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm text-base-content/70">
      <span class="in-data-[details=on]:hidden">Summary: Carried over, Refunded and Reallocated aren't shown, so these figures don't add up on their own.</span>
      <span class="hidden in-data-[details=on]:inline">Details: every figure that makes up Available is shown.</span>
    </p>
    <div class="join ml-auto" role="group" aria-label="How much to show">
      <button type="button" class="btn btn-sm join-item aria-pressed:btn-active" aria-pressed="true" data-value="off" data-month-details-target="button" data-action="month-details#choose" data-month-details-value-param="off">Summary</button>
      <button type="button" class="btn btn-sm join-item aria-pressed:btn-active" aria-pressed="false" data-value="on" data-month-details-target="button" data-action="month-details#choose" data-month-details-value-param="on">Details</button>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Envelope</th>
          <th scope="col" class="hidden text-right sm:in-data-[details=on]:table-cell">Carried over</th>
          <th scope="col" class="text-right">Assigned</th>
          <th scope="col" class="text-right">Spent</th>
          <th scope="col" class="hidden text-right sm:in-data-[details=on]:table-cell">Refunded</th>
          <th scope="col" class="hidden text-right sm:in-data-[details=on]:table-cell">Reallocated</th>
          <th scope="col" class="text-right">Available</th>
        </tr>
      </thead>
      <tbody>
        <% month.envelopes.each do |line| %>
          <% level = available_level(line) %>
          <tr id="<%= dom_id(line.envelope) %>">
            <td>
              <%= link_to line.envelope.name, month_envelope_path(month, line.envelope), class: "link" %>
              <% if line.envelope.archived? %><%= render "components/archived_badge" %><% end %>
            </td>
            <td class="hidden text-right tabular-nums sm:in-data-[details=on]:table-cell"><%= render "components/money", amount: line.carried_over, budget: budget %></td>
            <td class="text-right tabular-nums"><%= render "months/prototype/assigned_cell", line: line, month: month, budget: budget, origin_page: origin_page %></td>
            <td class="text-right tabular-nums"><%= render "components/money", amount: line.spent, budget: budget %></td>
            <td class="hidden text-right tabular-nums sm:in-data-[details=on]:table-cell"><%= render "components/money", amount: line.refunded, budget: budget %></td>
            <td class="hidden text-right tabular-nums sm:in-data-[details=on]:table-cell"><%= render "components/money", amount: line.reallocated, budget: budget %></td>
            <td class="text-right align-top tabular-nums">
              <div class="relative px-2 py-1">
                <% unless level == :none %>
                  <progress class="progress <%= level_bar_class(level) %> absolute inset-0 h-full w-full opacity-25" value="<%= available_percent(line) %>" max="100" aria-hidden="true"></progress>
                <% end %>
                <div class="relative">
                  <% unless level == :none %><span class="mr-1 font-bold" title="<%= level_word(level) %>"><%= level_icon(level) %><span class="sr-only"><%= level_word(level) %></span></span><% end %>
                  <%= render "components/money", amount: line.available, budget: budget, overspent: line.overspent? %>
                </div>
              </div>
              <dl class="mt-1 hidden text-xs text-base-content/70 in-data-[details=on]:block sm:in-data-[details=on]:hidden">
                <div>Carried over <%= render "components/money", amount: line.carried_over, budget: budget %></div>
                <div>Refunded <%= render "components/money", amount: line.refunded, budget: budget %></div>
                <div>Reallocated <%= render "components/money", amount: line.reallocated, budget: budget %></div>
              </dl>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
