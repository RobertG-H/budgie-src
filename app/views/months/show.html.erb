<% content_for :title, "#{@month.name} · Budgie" %>
<%# Saving an Assigned amount comes back here, to the same page, and Turbo refreshes it in place: it morphs the page into the new one and keeps the scroll position, so every figure updates and the person stays where they were. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% budget = @month.budget %>
<%# The current month is the home page as well as /months/YYYY-MM, and an amount edited here goes back to whichever of them it was opened from. See ReturnsToOrigin. %>
<% origin_page = current_page?(root_path) ? "home" : "month" %>
<% ready_to_assign = @month.ready_to_assign %>

<%= render "components/page_header", title: @month.name do %>
  <%= link_to "New spend", new_spend_path(month: @month, from: "month"), class: "btn btn-primary" %>
  <%= link_to "New deposit", new_deposit_path(month: @month, from: "month"), class: "btn" %>
  <%= link_to "New envelope", new_envelope_path(month: @month, from: "month"), class: "btn" %>
<% end %>

<div class="mt-4">
  <%= render "components/month_links", month: @month, path: ->(month) { month_path(month) }, picker: true %>
</div>

<div class="mt-8">
  <%= render "months/ready_to_assign", ready_to_assign: ready_to_assign, current: @month.current?, budget: budget,
        deposits_path: month_deposits_path(@month), new_deposit_path: new_deposit_path(month: @month, from: "month") %>
</div>

<div class="mt-8">
  <% if @month.envelopes.any? %>
    <%# Carried over, Refunded and Reallocated are behind the toggle: columns from sm: up, and below it a second row of labelled figures under each envelope's own, so each envelope is a tbody of its own. See months/_details_toggle. %>
    <div data-controller="month-details" data-action="turbo:morph@document->month-details#sync">
      <%= render "months/details_toggle" %>

      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th scope="col" class="max-sm:pl-0">Envelope</th>
              <th scope="col" class="hidden text-right sm:in-data-[details=on]:table-cell"><%= render "components/term", key: :carried_over, placement: :bottom %></th>
              <th scope="col" class="text-right"><%= render "components/term", key: :assigned, placement: :bottom %></th>
              <th scope="col" class="text-right">Spent</th>
              <th scope="col" class="hidden text-right sm:in-data-[details=on]:table-cell">Refunded</th>
              <th scope="col" class="hidden text-right sm:in-data-[details=on]:table-cell"><%= render "components/term", key: :reallocated, placement: :bottom %></th>
              <th scope="col" class="text-right max-sm:pr-0">Available</th>
            </tr>
          </thead>
          <% @month.envelopes.each do |line| %>
            <tbody>
              <tr id="<%= dom_id(line.envelope) %>" class="in-data-[details=on]:max-sm:*:border-b-0">
                <td class="align-top leading-8 max-sm:pl-0">
                  <%= link_to line.envelope.name, month_envelope_path(@month, line.envelope), class: "link text-base font-medium" %>
                  <% if line.envelope.archived? %><%= render "components/archived_badge" %><% end %>
                  <%= render "components/available_bar", line: line %>
                </td>
                <td class="hidden text-right align-top leading-8 tabular-nums sm:in-data-[details=on]:table-cell"><%= render "components/money", amount: line.carried_over, budget: budget %></td>
                <%# An archived envelope's Assigned is read-only, so it's plain text and not the input's button. %>
                <td class="text-right align-top leading-8 tabular-nums">
                  <% if line.envelope.archived? %>
                    <%= render "components/money", amount: line.assigned, budget: budget %>
                  <% else %>
                    <%= render "assignments/cell", line: line, month: @month, from: origin_page %>
                  <% end %>
                </td>
                <td class="text-right align-top leading-8 tabular-nums"><%= render "components/money", amount: line.spent, budget: budget %></td>
                <td class="hidden text-right align-top leading-8 tabular-nums sm:in-data-[details=on]:table-cell"><%= render "components/money", amount: line.refunded, budget: budget %></td>
                <td class="hidden text-right align-top leading-8 tabular-nums sm:in-data-[details=on]:table-cell"><%= render "components/money", amount: line.reallocated, budget: budget %></td>
                <td class="text-right align-top leading-8 tabular-nums max-sm:pr-0"><%= render "components/available_pill", line: line, budget: budget %></td>
              </tr>
              <%# On a phone, with details on: the three figures the columns above hold from sm: up. Four columns show there, so it spans four. %>
              <tr class="hidden in-data-[details=on]:max-sm:table-row">
                <td colspan="4" class="pt-0 max-sm:px-0">
                  <dl class="grid grid-cols-3 gap-2 text-xs">
                    <div><dt class="text-base-content/70">Carried over</dt><dd class="tabular-nums"><%= render "components/money", amount: line.carried_over, budget: budget %></dd></div>
                    <div><dt class="text-base-content/70">Refunded</dt><dd class="tabular-nums"><%= render "components/money", amount: line.refunded, budget: budget %></dd></div>
                    <div><dt class="text-base-content/70">Reallocated</dt><dd class="tabular-nums"><%= render "components/money", amount: line.reallocated, budget: budget %></dd></div>
                  </dl>
                </td>
              </tr>
            </tbody>
          <% end %>
        </table>
      </div>
    </div>
  <% else %>
    <%# Envelopes in use always show, so a table with none is the budget with none at all, or with all of them archived and none of them with a figure this month. %>
    <%= render "components/empty_state", message: (@month.archived_envelopes.any? ? "All your envelopes are archived." : "You don't have any envelopes yet.") do %>
      <%= link_to "New envelope", new_envelope_path(month: @month, from: "month"), class: "btn btn-primary" %>
    <% end %>
  <% end %>
</div>

<%# What the figures mean, in words: the same sentences as the tooltips on the card's title and the table's headers, which a phone can't hover. %>
<%= render "help/figures" %>

<%# Every archived envelope, whether this month shows it or not, so one can be found to unarchive it. Each links to its page for the month being viewed. Only there when the budget has some. %>
<% if @month.archived_envelopes.any? %>
  <details class="mt-8 rounded-box border border-base-300">
    <summary class="cursor-pointer p-4 font-semibold">Archived envelopes</summary>
    <ul class="divide-y divide-base-300 border-t border-base-300">
      <% @month.archived_envelopes.each do |envelope| %>
        <li><%= link_to envelope.name, month_envelope_path(@month, envelope), class: "link block p-4" %></li>
      <% end %>
    </ul>
  </details>
<% end %>
