# Secrets for -d testing, read after .kamal/secrets-common.
#
# This file only maps names, so it's safe to commit. The values come from the gitignored .env.testing on
# the operator's laptop, which the kamal Compose service loads for a break-glass deploy, or from the
# testing GitHub environment's secrets in CI's deploy_testing job. See docs/deployment.md. Never put a
# value here. The names are prefixed because every env file is loaded into every run on the laptop; CI
# keeps the same names, even though deploy_testing only ever sees the testing environment's secrets.
SECRET_KEY_BASE=$TESTING_SECRET_KEY_BASE
BUDGIE_DATABASE_PASSWORD=$TESTING_BUDGIE_DATABASE_PASSWORD
GOOGLE_CLIENT_ID=$TESTING_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$TESTING_GOOGLE_CLIENT_SECRET
SMTP_USERNAME=$TESTING_SMTP_USERNAME
SMTP_PASSWORD=$TESTING_SMTP_PASSWORD
