# Secrets for every destination. Kamal reads this file first, then .kamal/secrets.<destination>.
#
# This file only maps names, so it's safe to commit. The values are in the gitignored .env.kamal on the
# operator's laptop, which the kamal Compose service loads. See docs/deployment.md. Never put a value here.

# A classic GitHub token with write:packages, for ghcr.io.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
