# Secrets for -d production, read after .kamal/secrets-common.
#
# This file only maps names, so it's safe to commit. The values come from the gitignored .env.production on
# the operator's laptop, which the kamal Compose service loads for a break-glass deploy, or from the
# production GitHub environment's secrets in deploy-production.yml's deploy job. See docs/deployment.md.
# Never put a value here. The names are prefixed because every env file is loaded into every run on the
# laptop; CI keeps the same names, even though that job only ever sees the production environment's secrets.
SECRET_KEY_BASE=$PRODUCTION_SECRET_KEY_BASE
BUDGIE_DATABASE_PASSWORD=$PRODUCTION_BUDGIE_DATABASE_PASSWORD
GOOGLE_CLIENT_ID=$PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$PRODUCTION_GOOGLE_CLIENT_SECRET
SMTP_USERNAME=$PRODUCTION_SMTP_USERNAME
SMTP_PASSWORD=$PRODUCTION_SMTP_PASSWORD
